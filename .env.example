DB_PASSWORD=generate-a-long-random-password
DB_ROOT_PASSWORD=generate-a-different-long-random-password
DISCORD_CLIENT_ID=your-discord-application-id
DISCORD_CLIENT_SECRET=your-discord-client-secret
FLAG_PEPPER=generate-at-least-32-random-characters
CTF_HOST=ctf.example.org

# Keep true for simple deployments. Set false when migrations are applied as a
# separate deployment step before starting or scaling the web service.
APPLY_DATABASE_MIGRATIONS=true

# Optional ports and image tag
HTTP_PORT=80
HTTPS_PORT=443
OWLCTF_IMAGE_TAG=local

# Resource limits; tune these for the host and expected attendance
WEB_CPUS=1.00
WEB_MEMORY_LIMIT=768m
WEB_DB_POOL_SIZE=40
CADDY_CPUS=0.50
CADDY_MEMORY_LIMIT=128m
DB_CPUS=1.50
DB_MEMORY_LIMIT=1g
DB_BUFFER_POOL_SIZE=256M
DB_MAX_CONNECTIONS=160
REDIS_CPUS=0.25
REDIS_MEMORY_LIMIT=96m
REDIS_MAX_MEMORY=64mb

# Change both values together if this subnet overlaps an existing Docker network
BACKEND_SUBNET=172.30.0.0/24
CADDY_PROXY_IP=172.30.0.2

# Dynamic challenge instances. The feature is enabled only when this is true
# and the stack is started with compose.instances.yaml.
DYNAMIC_INSTANCES_ENABLED=false

# Keep false to log and notify on cross-team flag use without automatically
# banning the submitting team. Set true only after reviewing the policy.
AUTO_BAN_ON_CHEAT=false

# Only required with compose.instances.yaml
DOCKER_GID=999
DOCKER_SOCKET=/var/run/docker.sock
INSTANCE_PUBLIC_HOST=ctf.example.org
INSTANCE_CONCURRENCY_LIMIT=20
