@using System.Text.Json
@using OwlCTF.Services
@model StandingsViewModel
@{
  ViewData["Title"] = "Standings";
  var cspNonce = Context.Items["CspNonce"] as string;
  var chartSeries = Model.Series.Select(s => new
  {
    name = s.TeamName,
    data = s.Points.Select(p => new object[] { TimeDisplay.UtcIso(p.AtUtc), p.Score }).ToArray()
  });
}
<main><div class="container">
  <h1 class="welcome-heading">Standings</h1>
  @if (Model.State.Phase == CtfPhase.Upcoming)
  {
    <div class="alert alert-info mt-3">
      The event has not started yet. Standings will appear
      @if (Model.State.StartsAtUtc is DateTime startsAt)
      { <span>once the CTF begins at <time data-local-time datetime="@TimeDisplay.UtcIso(startsAt)">@startsAt.ToString("yyyy-MM-dd HH:mm")</time>.</span> }
    </div>
  }
  @if (Model.State.Phase == CtfPhase.Unscheduled)
  {
    <div class="alert alert-secondary mt-3">
      @if (Model.Standings.Count == 0)
      { <span>No event is scheduled yet. Standings will appear once teams start competing.</span> }
      else
      { <span>No event is scheduled yet. Previous scores are shown below for reference.</span> }
    </div>
  }
  @if (Model.State.Phase != CtfPhase.Upcoming && Model.Series.Count > 0)
  {
    <section id="scoreboardChart" class="scoreboard-chart-shell mt-4" aria-labelledby="scoreboardChartTitle">
      <div class="scoreboard-chart-toolbar">
        <h2 id="scoreboardChartTitle" class="scoreboard-chart-title">Top 10 teams</h2>
        <div class="scoreboard-chart-actions">
          <button id="zoomInScoreChart" class="scoreboard-chart-action" type="button" aria-label="Zoom in on chart" title="Zoom in"><i class="bi bi-zoom-in" aria-hidden="true"></i></button>
          <button id="zoomOutScoreChart" class="scoreboard-chart-action" type="button" aria-label="Zoom out of chart" title="Zoom out"><i class="bi bi-zoom-out" aria-hidden="true"></i></button>
          <button id="resetScoreChart" class="scoreboard-chart-action" type="button" aria-label="Reset chart zoom" title="Reset zoom"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i></button>
          <button id="fullscreenScoreChart" class="scoreboard-chart-action" type="button" aria-label="View chart fullscreen" title="Fullscreen"><i class="bi bi-fullscreen" aria-hidden="true"></i></button>
        </div>
      </div>
      <div class="scoreboard-chart-body">
        <div id="scoreChart" class="score-chart-echarts" aria-label="Cumulative score progression for the top 10 teams" role="img"></div>
      </div>
    </section>
  }
  @if (Model.State.Phase != CtfPhase.Upcoming)
  {
  <div class="panel @(Model.Series.Count == 0 ? "mt-4" : "")"><div class="table-responsive"><table class="table table-hover mb-0 align-middle">
    <thead><tr><th scope="col">Rank</th><th scope="col">Team</th><th scope="col">Bracket</th><th scope="col">Score</th><th scope="col">Solves</th><th scope="col">Last solve (local time)</th></tr></thead>
    <tbody>
    @if (Model.Standings.Count == 0) { <tr><td colspan="6" class="text-center py-4">@(Model.State.Phase == CtfPhase.Unscheduled ? "Standings will appear after an event is scheduled." : "No teams have joined yet.")</td></tr> }
    @foreach (var row in Model.Standings)
    {
      var countryName = CountryCatalog.All.FirstOrDefault(c => c.Code == row.CountryCode)?.Name;
      var countryCode = row.CountryCode?.ToLowerInvariant();
      <tr>
        <td>@row.Rank</td>
        <td>
          <span class="standings-team-line">
            <a asp-controller="Directory" asp-action="Team" asp-route-id="@row.TeamId" class="text-decoration-none fw-medium">@row.TeamName</a>
            @if (countryName is not null && countryCode is not null)
            { <span class="fi fi-@countryCode standings-team-flag" role="img" aria-label="@countryName flag" title="@countryName"></span> }
          </span>
        </td>
        <td>@TeamBracketCatalog.Get(row.BracketKey).Name</td>
        <td class="fw-bold">@row.Score</td><td>@row.SolveCount</td><td>@if (row.LastSolveAtUtc is DateTime lastSolve) { <time data-local-time datetime="@TimeDisplay.UtcIso(lastSolve)">@lastSolve.ToString("yyyy-MM-dd HH:mm:ss")</time> } else { <span>—</span> }</td>
      </tr>
    }
    </tbody>
  </table></div></div>
  }
</div></main>
@if (Model.State.Phase != CtfPhase.Upcoming && Model.Series.Count > 0)
{
  @section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/echarts@5.6.0/dist/echarts.min.js"></script>
    <script nonce="@cspNonce">
      (() => {
        const rawSeries = @Html.Raw(JsonSerializer.Serialize(chartSeries));
        const chartStart = @Html.Raw(JsonSerializer.Serialize(TimeDisplay.UtcIso(Model.ChartStartUtc)));
        const chartEnd = @Html.Raw(JsonSerializer.Serialize(TimeDisplay.UtcIso(Model.ChartEndUtc)));
        const chartElement = document.getElementById('scoreChart');
        const chartShell = document.getElementById('scoreboardChart');
        const fullscreenButton = document.getElementById('fullscreenScoreChart');
        const zoomInButton = document.getElementById('zoomInScoreChart');
        const zoomOutButton = document.getElementById('zoomOutScoreChart');
        const resetZoomButton = document.getElementById('resetScoreChart');
        const scoreChart = echarts.init(chartElement);
        const formatLocalDate = value => {
          const date = new Date(value);
          return date.toLocaleDateString(undefined, { day: '2-digit', month: 'short' });
        };
        const formatLocalTime = value => {
          const date = new Date(value);
          return date.toLocaleTimeString(undefined, { hour: '2-digit', minute: '2-digit' });
        };
        const formatLocalDateTime = value => new Intl.DateTimeFormat(undefined, {
          day: '2-digit',
          month: 'short',
          year: 'numeric',
          hour: '2-digit',
          minute: '2-digit'
        }).format(new Date(value));
        const seriesData = rawSeries.map(series => {
          const points = series.data
            .map(point => [point[0], Number(point[1])])
            .sort((left, right) => Date.parse(left[0]) - Date.parse(right[0]));
          if (points.length === 0)
            return { name: series.name, data: [[chartStart, 0], [chartEnd, 0]] };

          const result = [[chartStart, 0], ...points];
          result.push([chartEnd, points[points.length - 1][1]]);
          return { name: series.name, data: result };
        });

        const getChartTheme = () => {
          const styles = getComputedStyle(chartShell);
          return {
            text: styles.getPropertyValue('--score-chart-muted').trim(),
            heading: styles.getPropertyValue('--score-chart-heading').trim(),
            grid: styles.getPropertyValue('--score-chart-grid').trim(),
            tooltipBackground: styles.getPropertyValue('--score-chart-tooltip-bg').trim(),
            tooltipText: styles.getPropertyValue('--score-chart-tooltip-text').trim(),
            tooltipBorder: styles.getPropertyValue('--score-chart-tooltip-border').trim()
          };
        };

        const buildOptions = () => {
          const theme = getChartTheme();
          return {
            animation: false,
            useUTC: false,
            color: ['#4f7cff', '#c9e94f', '#626b91', '#ff984a', '#18a7d0', '#ffd321', '#ef5b83', '#835bb1', '#48bea1', '#7096e6'],
            tooltip: {
              trigger: 'axis',
              backgroundColor: theme.tooltipBackground,
              borderColor: theme.tooltipBorder,
              textStyle: { color: theme.tooltipText },
              axisPointer: {
                type: 'cross',
                label: {
                  color: theme.tooltipText,
                  backgroundColor: theme.tooltipBackground,
                  formatter: value => value.axisDimension === 'x'
                    ? formatLocalDateTime(value.value)
                    : Number(value.value).toLocaleString()
                }
              },
              valueFormatter: value => Number(value).toLocaleString()
            },
            legend: {
              type: 'scroll',
              orient: 'horizontal',
              align: 'left',
              bottom: 0,
              textStyle: { color: theme.text }
            },
            toolbox: {
              right: 8,
              feature: {
                saveAsImage: { name: 'owlctf-scoreboard', backgroundColor: 'auto' },
                dataZoom: {}
              },
              iconStyle: { borderColor: theme.text },
              emphasis: { iconStyle: { borderColor: theme.heading } }
            },
            dataZoom: [{
              type: 'inside',
              xAxisIndex: 0,
              start: 0,
              end: 100,
              filterMode: 'none',
              zoomOnMouseWheel: true,
              moveOnMouseWheel: false,
              moveOnMouseMove: true,
              preventDefaultMouseMove: true
            }],
            grid: { containLabel: true, left: 16, right: 16, top: 54, bottom: 64 },
            xAxis: {
              type: 'time',
              name: 'Local time',
              nameLocation: 'middle',
              nameGap: 30,
              nameTextStyle: { color: theme.text },
              axisLine: { lineStyle: { color: theme.grid } },
              axisTick: { lineStyle: { color: theme.grid } },
              axisLabel: {
                color: theme.text,
                hideOverlap: true,
                formatter: value => {
                  const date = new Date(value);
                  return date.getHours() === 0 && date.getMinutes() === 0
                    ? formatLocalDate(value)
                    : formatLocalTime(value);
                }
              },
              splitLine: { show: false }
            },
            yAxis: {
              type: 'value',
              min: 0,
              axisLine: { show: false },
              axisTick: { show: false },
              axisLabel: { color: theme.text, formatter: value => Number(value).toLocaleString() },
              splitLine: { lineStyle: { color: theme.grid } }
            },
            series: seriesData.map(series => ({
              type: 'line',
              name: series.name,
              data: series.data,
              symbol: 'none',
              showSymbol: false,
              lineStyle: { width: 1.6 },
              emphasis: { focus: 'series' }
            }))
          };
        };

        scoreChart.setOption(buildOptions());

        const applyChartTheme = () => {
          const selected = scoreChart.getOption().legend?.[0]?.selected;
          const currentZoom = scoreChart.getOption().dataZoom?.[0];
          scoreChart.setOption(buildOptions(), true);
          if (selected) scoreChart.setOption({ legend: { selected } });
          if (currentZoom) scoreChart.dispatchAction({ type: 'dataZoom', start: currentZoom.start, end: currentZoom.end });
        };
        new MutationObserver(applyChartTheme).observe(document.documentElement, { attributes: true, attributeFilter: ['data-bs-theme'] });

        const changeZoom = factor => {
          const zoom = scoreChart.getOption().dataZoom?.[0] ?? { start: 0, end: 100 };
          const start = Number(zoom.start ?? 0);
          const end = Number(zoom.end ?? 100);
          const center = (start + end) / 2;
          const halfRange = Math.min(50, Math.max(2.5, ((end - start) * factor) / 2));
          scoreChart.dispatchAction({
            type: 'dataZoom',
            start: Math.max(0, center - halfRange),
            end: Math.min(100, center + halfRange)
          });
        };
        zoomInButton.addEventListener('click', () => changeZoom(0.6));
        zoomOutButton.addEventListener('click', () => changeZoom(1.65));
        resetZoomButton.addEventListener('click', () =>
          scoreChart.dispatchAction({ type: 'dataZoom', start: 0, end: 100 }));

        fullscreenButton.addEventListener('click', async () => {
          if (document.fullscreenElement === chartShell) await document.exitFullscreen();
          else await chartShell.requestFullscreen();
        });
        document.addEventListener('fullscreenchange', () => {
          const isFullscreen = document.fullscreenElement === chartShell;
          fullscreenButton.querySelector('i').className = isFullscreen ? 'bi bi-fullscreen-exit' : 'bi bi-fullscreen';
          fullscreenButton.setAttribute('aria-label', isFullscreen ? 'Exit fullscreen chart' : 'View chart fullscreen');
          setTimeout(() => scoreChart.resize(), 0);
        });
        window.addEventListener('resize', () => scoreChart.resize());
      })();
    </script>
  }
}
