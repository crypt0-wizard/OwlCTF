@model ChallengesViewModel
@using OwlCTF.Services
@{ ViewData["Title"] = "Challenges"; }
<main><div class="container">
  <h1 class="welcome-heading">Challenges</h1>
  @if (Model.State.Phase == CtfPhase.Unscheduled)
  { <div class="alert alert-secondary mt-3">No event is scheduled yet. You can browse the challenges but submissions will stay closed until a date is set.</div> }
  @if (User.Identity?.IsAuthenticated != true)
  { <div class="alert alert-info mt-3">Sign in with Discord to open challenges, download files and submit flags.</div> }
  else if (Model.Team is null)
  { <div class="alert alert-warning mt-3"><a asp-controller="Teams" asp-action="Index">Create or join a team</a> before you submit a flag.</div> }
  else if (Model.Team.IsSuspended)
  { <div class="alert alert-danger mt-3">Your team is suspended and cannot submit flags.</div> }
  <form method="get" class="d-flex justify-content-end align-items-center gap-2 mt-3">
    @if (Model.AvailableTags.Count > 0)
    {
      <label for="challengeTag" class="form-label mb-0">Tag</label>
      <select id="challengeTag" name="tag" class="form-select form-select-sm w-auto">
        <option value="">All tags</option>
        @foreach (var tag in Model.AvailableTags)
        { <option value="@tag" selected="@(Model.SelectedTag == tag ? "selected" : null)">@tag</option> }
      </select>
    }
    <label for="challengeSort" class="form-label mb-0">Sort challenges</label>
    <select id="challengeSort" name="sort" class="form-select form-select-sm w-auto">
      <option value="points-asc" selected="@(Model.Sort == "points-asc" ? "selected" : null)">Points: low to high</option>
      <option value="points-desc" selected="@(Model.Sort == "points-desc" ? "selected" : null)">Points: high to low</option>
      <option value="name" selected="@(Model.Sort == "name" ? "selected" : null)">Name: A–Z</option>
      <option value="solves" selected="@(Model.Sort == "solves" ? "selected" : null)">Most solved</option>
    </select>
    <button class="btn btn-owlctf btn-sm" type="submit">Apply</button>
  </form>
  @if (Model.Challenges.Count == 0)
  { <div class="panel mt-4"><div class="panel-body text-center">@(Model.SelectedTag is null ? "No challenges are available yet." : $"No challenges use the {Model.SelectedTag} tag.")</div></div> }
  @foreach (var category in ChallengeCategoryCatalog.All)
  {
    var categoryChallenges = Model.Challenges.Where(challenge => ChallengeCategoryCatalog.Get(challenge.CategoryKey).Key == category.Key).ToArray();
    if (categoryChallenges.Length > 0)
    {
      <section class="mt-4" aria-labelledby="category-@category.Key">
        <h2 id="category-@category.Key" class="category-heading h4 mb-3"><span class="category-icon"><i class="@category.IconClass" aria-hidden="true"></i></span><span>@category.Name</span></h2>
        <div class="row g-3">
        @foreach (var challenge in categoryChallenges)
        {
          <div class="col-sm-6 col-lg-4 col-xl-3">
            <a class="challenge-card challenge-tile h-100 @(challenge.IsSolved ? "challenge-solved" : "")" asp-action="Detail" asp-route-id="@challenge.Id">
              @if (challenge.IsSolved)
              { <span class="challenge-tile-solved" aria-label="Solved" title="Solved"><i class="bi bi-check-lg" aria-hidden="true"></i></span> }
              <span class="challenge-card-title">@challenge.Title</span>
              <strong class="challenge-card-points">@challenge.CurrentValue</strong>
              <span class="challenge-card-solves">@challenge.SolveCount @(challenge.SolveCount == 1 ? "solve" : "solves")</span>
              @if (challenge.TagList.Count > 0)
              {
                <span class="challenge-card-tags" aria-label="Tags">
                  @foreach (var tag in challenge.TagList.Take(3))
                  { <span class="challenge-tag">@tag</span> }
                  @if (challenge.TagList.Count > 3)
                  { <span class="challenge-tag-more">+@(challenge.TagList.Count - 3)</span> }
                </span>
              }
            </a>
          </div>
        }
        </div>
      </section>
    }
  }
</div></main>
