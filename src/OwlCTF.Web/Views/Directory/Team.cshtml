@model PublicTeamViewModel
@using OwlCTF.Services
@inject ChallengeCategoryService ChallengeCategories
@{
  ViewData["Title"] = Model.Team.Name;
  var country = CountryCatalog.All.FirstOrDefault(item => item.Code == Model.Team.CountryCode);
  var categories = await ChallengeCategories.GetAllAsync(Context.RequestAborted);
}
<main><div class="container">
  <a asp-controller="Standings" asp-action="Index" class="text-decoration-none">← Standings</a>
  <div class="mt-3 mb-4">
    <h1 class="welcome-heading mb-2">@Model.Team.Name</h1>
    @if (Model.Team.IsDisbanded)
    { <p class="text-body-secondary mb-0">This team has disbanded. Its event history is still available.</p> }
  </div>
  <div class="profile-details mb-4">
    <div class="profile-detail-row">
      <span class="text-body-secondary">Country</span>
      <span>
        @if (country is not null)
        { <span class="team-country"><span class="fi fi-@(country.Code.ToLowerInvariant()) team-profile-flag" role="img" aria-label="@country.Name flag"></span><span>@country.Name</span></span> }
        else
        { <span>Not selected</span> }
      </span>
    </div>
    <div class="profile-detail-row"><span class="text-body-secondary">Bracket</span><span>@TeamBracketCatalog.Get(Model.Team.BracketKey).Name</span></div>
    <div class="profile-detail-row"><span class="text-body-secondary">Status</span><span>@(string.IsNullOrWhiteSpace(Model.Team.Status) ? "No status" : Model.Team.Status)</span></div>
    <div class="profile-detail-row"><span class="text-body-secondary">Score</span><span>@Model.Team.Score</span></div>
    <div class="profile-detail-row"><span class="text-body-secondary">Team solves</span><span>@Model.Team.SolveCount</span></div>
  </div>
  <div class="panel">
    <div class="panel-header">Members</div>
    <div class="list-group list-group-flush">
    @foreach (var member in Model.Members)
    {
      <a class="list-group-item list-group-item-action d-flex align-items-center gap-3" asp-controller="Directory" asp-action="Member" asp-route-id="@member.Id">
        <img class="discord-avatar" src="@DiscordAvatar.Url(member.DiscordId, member.AvatarHash, 64)" alt="" width="40" height="40" loading="lazy" referrerpolicy="no-referrer">
        <span class="flex-grow-1 fw-medium">@member.Username</span>
        <span class="text-body-secondary">@member.SolveCount solves · @member.PointsEarned pts</span>
        <i class="bi bi-chevron-right" aria-hidden="true"></i>
      </a>
    }
    </div>
  </div>
  <div class="panel">
    <div class="panel-header d-flex justify-content-between"><span>Team solve history</span><span class="badge text-bg-secondary">@Model.Solves.Count</span></div>
    @if (Model.Solves.Count == 0)
    { <div class="panel-body text-center text-body-secondary">No visible solves yet.</div> }
    else
    {
      <div class="table-responsive"><table class="table table-hover align-middle mb-0">
        <thead><tr><th>Challenge</th><th>Category</th><th>Solved by</th><th>Points</th><th>Solved at (local time)</th></tr></thead>
        <tbody>@foreach (var solve in Model.Solves) { var category = ChallengeCategoryCatalog.Resolve(solve.CategoryKey, categories); <tr><td>@solve.ChallengeTitle</td><td><span class="category-label"><span class="category-icon-sm"><i class="@category.IconClass" aria-hidden="true"></i></span><span>@category.Name</span></span></td><td><a asp-controller="Directory" asp-action="Member" asp-route-id="@solve.SolverUserId">@solve.SolverUsername</a></td><td>@solve.PointsAwarded</td><td><time data-local-time datetime="@TimeDisplay.UtcIso(solve.SolvedAtUtc)">@solve.SolvedAtUtc.ToString("yyyy-MM-dd HH:mm:ss")</time></td></tr> }</tbody>
      </table></div>
    }
  </div>
</div></main>
