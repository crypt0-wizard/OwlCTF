@model PublicMemberViewModel
@using OwlCTF.Services
@{
  ViewData["Title"] = Model.Member.Username;
  var country = CountryCatalog.All.FirstOrDefault(item => item.Code == Model.Member.CountryCode);
}
<main><div class="container">
  <a asp-controller="Directory" asp-action="Team" asp-route-id="@Model.Member.TeamId" class="text-decoration-none">← @Model.Member.TeamName</a>
  <div class="d-flex flex-column flex-md-row align-items-center align-items-md-start gap-4 mt-4 mb-4">
    <img class="profile-avatar" src="@DiscordAvatar.Url(Model.Member.DiscordId, Model.Member.AvatarHash, 256)" alt="@Model.Member.Username's Discord avatar" width="112" height="112" referrerpolicy="no-referrer">
    <div class="text-center text-md-start">
      <h1 class="welcome-heading mb-2">@Model.Member.Username</h1>
      <p class="text-body-secondary mb-0">Team member</p>
    </div>
  </div>
  <div class="profile-details mb-4">
    <div class="profile-detail-row"><span class="text-body-secondary">Team</span><span><a asp-controller="Directory" asp-action="Team" asp-route-id="@Model.Member.TeamId">@Model.Member.TeamName</a></span></div>
    <div class="profile-detail-row">
      <span class="text-body-secondary">Country</span>
      <span>
        @if (country is not null)
        { <span class="team-country"><span class="fi fi-@(country.Code.ToLowerInvariant()) team-profile-flag" role="img" aria-label="@country.Name flag"></span><span>@country.Name</span></span> }
        else
        { <span>Not selected</span> }
      </span>
    </div>
    <div class="profile-detail-row"><span class="text-body-secondary">Bracket</span><span>@TeamBracketCatalog.Get(Model.Member.BracketKey).Name</span></div>
    <div class="profile-detail-row"><span class="text-body-secondary">Visible solves</span><span>@Model.Solves.Count</span></div>
    <div class="profile-detail-row"><span class="text-body-secondary">Points earned</span><span>@Model.Solves.Sum(solve => solve.PointsAwarded)</span></div>
  </div>
  <div class="panel">
    <div class="panel-header d-flex justify-content-between"><span>Challenges solved by @Model.Member.Username</span><span class="badge text-bg-secondary">@Model.Solves.Count</span></div>
    @if (Model.Solves.Count == 0)
    { <div class="panel-body text-center text-body-secondary">No visible solves yet.</div> }
    else
    {
      <div class="table-responsive"><table class="table table-hover align-middle mb-0">
        <thead><tr><th>Challenge</th><th>Category</th><th>Points</th><th>Solved at (local time)</th></tr></thead>
        <tbody>@foreach (var solve in Model.Solves) { var category = ChallengeCategoryCatalog.Get(solve.CategoryKey); <tr><td>@solve.ChallengeTitle</td><td><span class="category-label"><span class="category-icon-sm"><i class="@category.IconClass" aria-hidden="true"></i></span><span>@category.Name</span></span></td><td>@solve.PointsAwarded</td><td><time data-local-time datetime="@TimeDisplay.UtcIso(solve.SolvedAtUtc)">@solve.SolvedAtUtc.ToString("yyyy-MM-dd HH:mm:ss")</time></td></tr> }</tbody>
      </table></div>
    }
  </div>
</div></main>
