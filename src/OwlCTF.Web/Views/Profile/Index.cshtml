@model ProfileRecord
@{
  ViewData["Title"] = "Profile";
  var defaultAvatarIndex = ulong.TryParse(Model.DiscordId, out var snowflake) ? (snowflake >> 22) % 6 : 0;
  var avatarUrl = !string.IsNullOrWhiteSpace(Model.AvatarHash)
    ? $"https://cdn.discordapp.com/avatars/{Model.DiscordId}/{Model.AvatarHash}.png?size=256"
    : $"https://cdn.discordapp.com/embed/avatars/{defaultAvatarIndex}.png";
}
<main><div class="container">
  <h1 class="welcome-heading">Profile</h1>
  <div class="panel mt-4">
    <div class="panel-body">
      <div class="d-flex flex-column flex-md-row align-items-center align-items-md-start gap-4">
        <img class="profile-avatar" src="@avatarUrl" alt="@Model.Username's Discord avatar" width="112" height="112">
        <div class="flex-grow-1 text-center text-md-start">
          <h2 class="h3 mb-1">@Model.Username</h2>
          <p class="text-body-secondary mb-0">Discord account</p>
        </div>
      </div>
      <div class="profile-details mt-4">
        <div class="profile-detail-row"><span class="text-body-secondary">Discord ID</span><code>@Model.DiscordId</code></div>
        <div class="profile-detail-row"><span class="text-body-secondary">Role</span><span>@(Model.IsAdmin ? "Administrator" : "Player")</span></div>
        <div class="profile-detail-row"><span class="text-body-secondary">Team</span><span>@if (Model.TeamName is not null) { <a asp-controller="Teams" asp-action="Index">@Model.TeamName</a> } else { <a asp-controller="Teams" asp-action="Index">No team</a> }</span></div>
        <div class="profile-detail-row"><span class="text-body-secondary">Team score</span><span>@Model.Score</span></div>
        <div class="profile-detail-row"><span class="text-body-secondary">Team solves</span><span>@Model.SolveCount</span></div>
        <div class="profile-detail-row"><span class="text-body-secondary">Joined (local time)</span><time data-local-time datetime="@TimeDisplay.UtcIso(Model.CreatedAtUtc)">@Model.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm")</time></div>
        <div class="profile-detail-row"><span class="text-body-secondary">Last login (local time)</span><time data-local-time datetime="@TimeDisplay.UtcIso(Model.LastLoginAtUtc)">@Model.LastLoginAtUtc.ToString("yyyy-MM-dd HH:mm")</time></div>
      </div>
    </div>
  </div>
</div></main>
