@model AdminTeamsViewModel
@using OwlCTF.Services
@{ ViewData["Title"] = "Manage teams"; }
<main><div class="container">
  <a asp-action="Index" class="text-decoration-none">← Administration</a>
  <div class="d-flex flex-wrap align-items-end justify-content-between gap-3 mt-3">
    <div>
      <h1 class="welcome-heading mb-1">Manage teams</h1>
      <p class="text-body-secondary mb-0">Keep track of teams and step in when one needs attention.</p>
    </div>
    <form method="get" class="d-flex flex-wrap align-items-end gap-2 admin-team-sort">
      <div>
        <label for="teamSort" class="form-label mb-1">Sort by</label>
        <select id="teamSort" name="sort" class="form-select form-select-sm">
          <option value="name" selected="@(Model.Sort == "name" ? "selected" : null)">Team name</option>
          <option value="captain" selected="@(Model.Sort == "captain" ? "selected" : null)">Captain</option>
          <option value="bracket" selected="@(Model.Sort == "bracket" ? "selected" : null)">Bracket</option>
          <option value="members" selected="@(Model.Sort == "members" ? "selected" : null)">Members</option>
          <option value="score" selected="@(Model.Sort == "score" ? "selected" : null)">Score</option>
          <option value="solves" selected="@(Model.Sort == "solves" ? "selected" : null)">Solves</option>
          <option value="created" selected="@(Model.Sort == "created" ? "selected" : null)">Created</option>
          <option value="state" selected="@(Model.Sort == "state" ? "selected" : null)">Participation state</option>
        </select>
      </div>
      <div>
        <label for="teamDirection" class="form-label mb-1">Direction</label>
        <select id="teamDirection" name="direction" class="form-select form-select-sm">
          <option value="asc" selected="@(Model.Direction == "asc" ? "selected" : null)">Ascending</option>
          <option value="desc" selected="@(Model.Direction == "desc" ? "selected" : null)">Descending</option>
        </select>
      </div>
      <button class="btn btn-outline-primary btn-sm" type="submit">Apply</button>
    </form>
  </div>

  <div class="row g-3 mt-2 mb-4">
    <div class="col-sm-6 col-lg-3"><div class="admin-stat"><span>Total teams</span><strong>@Model.Teams.Count</strong></div></div>
    <div class="col-sm-6 col-lg-3"><div class="admin-stat"><span>Active</span><strong>@Model.Teams.Count(team => !team.IsSuspended && !team.IsDisbanded)</strong></div></div>
    <div class="col-sm-6 col-lg-3"><div class="admin-stat"><span>Suspended</span><strong>@Model.Teams.Count(team => team.IsSuspended && !team.IsDisbanded)</strong></div></div>
    <div class="col-sm-6 col-lg-3"><div class="admin-stat"><span>Disbanded</span><strong>@Model.Teams.Count(team => team.IsDisbanded)</strong></div></div>
  </div>

  <div class="panel">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0 admin-teams-table">
        <thead><tr><th>Team</th><th>Captain</th><th>Bracket</th><th>Members</th><th>Score</th><th>Solves</th><th>Created (local time)</th><th>State</th><th>Manage</th></tr></thead>
        <tbody>
        @if (Model.Teams.Count == 0)
        { <tr><td colspan="9" class="text-center text-body-secondary py-5">No teams have registered yet.</td></tr> }
        @foreach (var team in Model.Teams)
        {
          var country = CountryCatalog.All.FirstOrDefault(item => item.Code == team.CountryCode);
          var countryCode = team.CountryCode?.ToLowerInvariant();
          <tr class="@(team.IsDisbanded ? "team-row-disbanded" : team.IsSuspended ? "team-row-suspended" : "")">
            <td>
              <span class="standings-team-line">
                @if (team.IsDisbanded) { <span class="fw-medium">@team.Name</span> } else { <a asp-controller="Directory" asp-action="Team" asp-route-id="@team.Id" class="fw-medium">@team.Name</a> }
                @if (country is not null && countryCode is not null) { <span class="fi fi-@countryCode standings-team-flag" role="img" aria-label="@country.Name flag" title="@country.Name"></span> }
              </span>
              <div class="small text-body-secondary mt-1">Join code: @if (team.IsDisbanded) { <span>Revoked</span> } else { <code>@team.JoinCode</code> }</div>
            </td>
            <td>@team.CaptainUsername</td>
            <td>@TeamBracketCatalog.Get(team.BracketKey).Name</td>
            <td>@team.MemberCount</td>
            <td class="fw-semibold">@team.Score</td>
            <td>@team.SolveCount</td>
            <td class="text-nowrap"><time data-local-time datetime="@TimeDisplay.UtcIso(team.CreatedAtUtc)">@team.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm")</time></td>
            <td>
              @if (team.IsDisbanded)
              {
                <span class="text-body-secondary fw-semibold">Disbanded</span>
                @if (team.DisbandedAtUtc is DateTime disbandedAt)
                { <div class="small text-body-secondary mt-1"><time data-local-time datetime="@TimeDisplay.UtcIso(disbandedAt)">@disbandedAt.ToString("yyyy-MM-dd HH:mm")</time></div> }
              }
              else if (team.IsSuspended)
              {
                <span class="text-danger fw-semibold">Suspended</span>
                @if (!string.IsNullOrWhiteSpace(team.SuspensionReason))
                { <div class="small text-body-secondary mt-1 admin-suspension-reason">@team.SuspensionReason</div> }
              }
              else
              { <span class="text-success fw-semibold">Active</span> }
            </td>
            <td>
              @if (team.IsDisbanded)
              {
                <span class="text-body-secondary small">Archived</span>
              }
              else if (team.IsSuspended)
              {
                <form asp-action="SetTeamSuspension" asp-route-id="@team.Id" asp-route-sort="@Model.Sort" asp-route-direction="@Model.Direction" method="post">
                  <input type="hidden" name="Suspended" value="false">
                  <button class="btn btn-outline-success btn-sm" type="submit">Restore</button>
                </form>
              }
              else
              {
                <details class="team-suspension-details">
                  <summary class="btn btn-outline-danger btn-sm">Suspend</summary>
                  <form asp-action="SetTeamSuspension" asp-route-id="@team.Id" asp-route-sort="@Model.Sort" asp-route-direction="@Model.Direction" method="post" class="team-suspension-form">
                    <input type="hidden" name="Suspended" value="true">
                    <label class="form-label small" for="reason-@team.Id">Internal reason</label>
                    <textarea class="form-control form-control-sm" id="reason-@team.Id" name="Reason" rows="3" maxlength="500" placeholder="Optional reason up to 500 characters"></textarea>
                    <button class="btn btn-danger btn-sm mt-2" type="submit">Confirm suspension</button>
                  </form>
                </details>
              }
            </td>
          </tr>
        }
        </tbody>
      </table>
    </div>
  </div>
</div></main>
