@model AdminSubmissionLogsViewModel
@using OwlCTF.Services
@{
  ViewData["Title"] = "Submission logs";
  var countries = CountryCatalog.All.ToDictionary(country => country.Code, StringComparer.OrdinalIgnoreCase);
  var firstResult = Model.MatchCount == 0 ? 0 : ((Model.Page - 1) * Model.PageSize) + 1;
  var lastResult = Math.Min(Model.Page * Model.PageSize, Model.MatchCount);
}
<main><div class="container">
  <a asp-action="Index" class="text-decoration-none">← Administration</a>
  <div class="d-flex flex-wrap align-items-end justify-content-between gap-3 mt-3 admin-page-header">
    <div>
      <h1 class="welcome-heading mb-1">Submission logs</h1>
      <p class="text-body-secondary mb-0">See every flag attempt with its challenge, team, member, result and source IP.</p>
    </div>
    <form method="get" class="d-flex flex-nowrap align-items-end gap-2 submission-log-controls">
      <div class="submission-log-search">
        <label for="submissionQuery" class="form-label mb-1">Search</label>
        <input id="submissionQuery" name="query" value="@Model.Query" class="form-control form-control-sm" maxlength="200" placeholder="Challenge, team, member, flag or IP">
      </div>
      <div>
        <label for="submissionResult" class="form-label mb-1">Result</label>
        <select id="submissionResult" name="result" class="form-select form-select-sm">
          <option value="all" selected="@(Model.Result == "all" ? "selected" : null)">All attempts</option>
          <option value="correct" selected="@(Model.Result == "correct" ? "selected" : null)">Correct</option>
          <option value="incorrect" selected="@(Model.Result == "incorrect" ? "selected" : null)">Incorrect</option>
        </select>
      </div>
      <div>
        <label for="submissionDirection" class="form-label mb-1">Order</label>
        <select id="submissionDirection" name="direction" class="form-select form-select-sm">
          <option value="desc" selected="@(Model.Direction == "desc" ? "selected" : null)">Newest first</option>
          <option value="asc" selected="@(Model.Direction == "asc" ? "selected" : null)">Oldest first</option>
        </select>
      </div>
      <button class="btn btn-outline-primary btn-sm" type="submit">Apply</button>
      @if (!string.IsNullOrWhiteSpace(Model.Query) || Model.Result != "all" || Model.Direction != "desc")
      { <a class="btn btn-outline-secondary btn-sm" asp-action="SubmissionLogs">Clear</a> }
    </form>
  </div>

  <div class="row g-3 mt-2 mb-4">
    <div class="col-sm-4"><div class="admin-stat"><span>Total attempts</span><strong>@Model.Summary.Total</strong></div></div>
    <div class="col-sm-4"><div class="admin-stat"><span>Correct</span><strong class="text-success">@Model.Summary.Correct</strong></div></div>
    <div class="col-sm-4"><div class="admin-stat"><span>Incorrect</span><strong class="text-danger">@Model.Summary.Incorrect</strong></div></div>
  </div>

  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
    <span class="text-body-secondary small">
      @if (Model.MatchCount == 0) { <text>No matching attempts</text> }
      else { <text>Showing @firstResult–@lastResult of @Model.MatchCount</text> }
    </span>
    @if (Model.TotalPages > 1)
    {
      <nav aria-label="Submission log pages">
        <ul class="pagination pagination-sm mb-0">
          <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
            <a class="page-link" asp-action="SubmissionLogs" asp-route-query="@Model.Query" asp-route-result="@Model.Result" asp-route-direction="@Model.Direction" asp-route-page="@(Model.Page - 1)">Previous</a>
          </li>
          <li class="page-item disabled"><span class="page-link">Page @Model.Page of @Model.TotalPages</span></li>
          <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
            <a class="page-link" asp-action="SubmissionLogs" asp-route-query="@Model.Query" asp-route-result="@Model.Result" asp-route-direction="@Model.Direction" asp-route-page="@(Model.Page + 1)">Next</a>
          </li>
        </ul>
      </nav>
    }
  </div>

  <div class="panel">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0 submission-logs-table">
        <thead><tr><th>Submitted (local time)</th><th>Challenge</th><th>Team</th><th>Member</th><th>Submitted flag</th><th>Result</th><th>IP address</th></tr></thead>
        <tbody>
        @if (Model.Attempts.Count == 0)
        { <tr><td colspan="7" class="text-center text-body-secondary py-5">No submission attempts match these filters.</td></tr> }
        @foreach (var attempt in Model.Attempts)
        {
          countries.TryGetValue(attempt.CountryCode ?? "", out var country);
          var countryCode = attempt.CountryCode?.ToLowerInvariant();
          <tr>
            <td class="text-nowrap"><time data-local-time datetime="@TimeDisplay.UtcIso(attempt.SubmittedAtUtc)">@attempt.SubmittedAtUtc.ToString("yyyy-MM-dd HH:mm:ss")</time></td>
            <td><a asp-controller="Challenges" asp-action="Detail" asp-route-id="@attempt.ChallengeId" class="fw-medium">@attempt.ChallengeTitle</a></td>
            <td>
              <span class="standings-team-line">
                <a asp-controller="Directory" asp-action="Team" asp-route-id="@attempt.TeamId" class="text-decoration-none fw-medium">@attempt.TeamName</a>
                @if (country is not null && countryCode is not null)
                { <span class="fi fi-@countryCode standings-team-flag" role="img" aria-label="@country.Name flag" title="@country.Name"></span> }
              </span>
            </td>
            <td><a asp-controller="Directory" asp-action="Member" asp-route-id="@attempt.UserId">@attempt.Username</a></td>
            <td>@if (string.IsNullOrEmpty(attempt.SubmittedFlag)) { <span class="text-body-secondary">Not captured</span> } else { <code class="submission-flag" dir="ltr">@attempt.SubmittedFlag</code> }</td>
            <td>@if (attempt.IsCorrect) { <span class="text-success fw-semibold">Correct</span> } else { <span class="text-danger fw-semibold">Incorrect</span> }</td>
            <td>@if (string.IsNullOrWhiteSpace(attempt.IpAddress)) { <span class="text-body-secondary">Not captured</span> } else { <code class="submission-ip" dir="ltr">@attempt.IpAddress</code> }</td>
          </tr>
        }
        </tbody>
      </table>
    </div>
  </div>
</div></main>
