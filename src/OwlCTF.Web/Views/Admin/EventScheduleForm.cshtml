@model EventScheduleInput
@{ ViewData["Title"] = "Event schedule"; }
<main><div class="container">
  <a asp-action="Index" class="text-decoration-none">← Platform management</a>
  <div class="mt-3 mb-4">
    <h1 class="welcome-heading mb-1">Event schedule</h1>
    <p class="text-body-secondary mb-0">Choose when play opens and closes. Enter both times in UTC.</p>
  </div>

  <form asp-action="SaveEventSchedule" method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <div class="panel">
      <div class="panel-header">Competition date and time</div>
      <div class="panel-body">
        <div class="row g-3">
          <div class="col-md-6">
            <label asp-for="StartsAtUtc" class="form-label"></label>
            <input asp-for="StartsAtUtc" class="form-control" type="datetime-local" value="@(Model.StartsAtUtc?.ToString("yyyy-MM-ddTHH:mm"))">
            <span asp-validation-for="StartsAtUtc" class="text-danger"></span>
            <div class="form-text">Leave this empty when no start time has been decided.</div>
          </div>
          <div class="col-md-6">
            <label asp-for="EndsAtUtc" class="form-label"></label>
            <input asp-for="EndsAtUtc" class="form-control" type="datetime-local" value="@(Model.EndsAtUtc?.ToString("yyyy-MM-ddTHH:mm"))">
            <span asp-validation-for="EndsAtUtc" class="text-danger"></span>
            <div class="form-text">Leave this empty when the event has no fixed end time.</div>
          </div>
        </div>
        <div class="alert alert-secondary mt-4 mb-0">The end time must be later than the start time when both are set.</div>
      </div>
    </div>
    <div class="d-flex flex-wrap gap-2">
      <button class="btn btn-owlctf" type="submit">Save schedule</button>
      <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
    </div>
  </form>
</div></main>
