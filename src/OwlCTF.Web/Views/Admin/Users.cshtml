@model AdminUsersViewModel
@{ ViewData["Title"] = "User management"; }
<main><div class="container">
  <a asp-action="Index" class="text-decoration-none">← Platform management</a>
  <div class="d-flex flex-wrap align-items-end justify-content-between gap-3 mt-3 admin-page-header">
    <div>
      <h1 class="welcome-heading mb-1">Users and administrators</h1>
      <p class="text-body-secondary mb-0">Search registered users and manage administrator access.</p>
    </div>
    <form method="get" class="d-flex flex-nowrap align-items-end gap-2 admin-user-controls">
      <div class="admin-user-search">
        <label for="userQuery" class="form-label mb-1">Search</label>
        <input id="userQuery" name="query" value="@Model.Query" class="form-control form-control-sm" maxlength="100" placeholder="Username or Discord ID">
      </div>
      <div>
        <label for="userSort" class="form-label mb-1">Sort by</label>
        <select id="userSort" name="sort" class="form-select form-select-sm">
          <option value="username" selected="@(Model.Sort == "username" ? "selected" : null)">Username</option>
          <option value="discord" selected="@(Model.Sort == "discord" ? "selected" : null)">Discord ID</option>
          <option value="last-login" selected="@(Model.Sort == "last-login" ? "selected" : null)">Last login</option>
          <option value="role" selected="@(Model.Sort == "role" ? "selected" : null)">Role</option>
        </select>
      </div>
      <div>
        <label for="userDirection" class="form-label mb-1">Direction</label>
        <select id="userDirection" name="direction" class="form-select form-select-sm">
          <option value="asc" selected="@(Model.Direction == "asc" ? "selected" : null)">Ascending</option>
          <option value="desc" selected="@(Model.Direction == "desc" ? "selected" : null)">Descending</option>
        </select>
      </div>
      <button class="btn btn-outline-primary btn-sm" type="submit">Apply</button>
      @if (!string.IsNullOrWhiteSpace(Model.Query))
      { <a class="btn btn-outline-secondary btn-sm" asp-action="ManageUsers" asp-route-sort="@Model.Sort" asp-route-direction="@Model.Direction">Clear</a> }
    </form>
  </div>

  <div class="row g-3 mt-2 mb-4">
    <div class="col-sm-4"><div class="admin-stat"><span>Total users</span><strong>@Model.TotalUsers</strong></div></div>
    <div class="col-sm-4"><div class="admin-stat"><span>Administrators</span><strong>@Model.AdministratorCount</strong></div></div>
    <div class="col-sm-4"><div class="admin-stat"><span>Players</span><strong>@(Model.TotalUsers - Model.AdministratorCount)</strong></div></div>
  </div>

  <div class="panel">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead><tr><th>User</th><th>Discord ID</th><th>Last login (local time)</th><th>Role</th><th>Manage</th></tr></thead>
        <tbody>
        @if (Model.Users.Count == 0)
        { <tr><td colspan="5" class="text-center text-body-secondary py-5">@(string.IsNullOrWhiteSpace(Model.Query) ? "No users have registered yet." : "No users match your search.")</td></tr> }
        @foreach (var user in Model.Users)
        {
          <tr>
            <td class="fw-medium">@user.Username</td>
            <td><code>@user.DiscordId</code></td>
            <td class="text-nowrap"><time data-local-time datetime="@TimeDisplay.UtcIso(user.LastLoginAtUtc)">@user.LastLoginAtUtc.ToString("yyyy-MM-dd HH:mm")</time></td>
            <td>@if (user.IsAdmin) { <span class="text-primary fw-semibold">Administrator</span> } else { <span>Player</span> }</td>
            <td>
              <form asp-action="SetAdmin" asp-route-id="@user.Id" asp-route-query="@Model.Query" asp-route-sort="@Model.Sort" asp-route-direction="@Model.Direction" method="post">
                <input type="hidden" name="enabled" value="@(!user.IsAdmin ? "true" : "false")">
                <button class="btn btn-sm @(user.IsAdmin ? "btn-outline-danger" : "btn-outline-primary")" type="submit">@(user.IsAdmin ? "Remove admin" : "Make admin")</button>
              </form>
            </td>
          </tr>
        }
        </tbody>
      </table>
    </div>
  </div>
</div></main>
