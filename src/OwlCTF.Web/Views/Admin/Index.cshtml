@model AdminDashboardViewModel
@{
  ViewData["Title"] = "Platform management";
  var useOwlCtfWordmark = string.Equals(Model.Settings.PlatformName, "OwlCTF", StringComparison.OrdinalIgnoreCase);
  var hasCustomNavbarLogo = !string.IsNullOrWhiteSpace(Model.Settings.NavbarLogoPath)
    && Model.Settings.NavbarLogoPath != BrandingStorage.DefaultLogoPath
    && Model.Settings.NavbarLogoPath != BrandingStorage.AdaptiveLogoPath;
  var hasCustomFavicon = !string.IsNullOrWhiteSpace(Model.Settings.FaviconPath)
    && Model.Settings.FaviconPath != BrandingStorage.DefaultFaviconPath;
}
<main><div class="container">
  <h1 class="welcome-heading mb-1">Platform management</h1>
  <p class="text-body-secondary">Set the look of the site, edit public content and manage event tools.</p>
  <div class="panel mt-4">
    <div class="panel-header">Navbar branding</div>
    <div class="panel-body">
      <div class="admin-branding-layout">
        <div class="admin-logo-preview">
          @if (!string.IsNullOrWhiteSpace(Model.Settings.NavbarLogoPath))
          {
            @if (Model.Settings.NavbarLogoPath == BrandingStorage.AdaptiveLogoPath)
            {
              <span class="site-brand-lockup">
                <span class="site-brand-mark admin-site-brand-mark" aria-hidden="true"></span>
                @if (useOwlCtfWordmark)
                { <span class="site-brand-wordmark"><span>Owl</span><span class="site-brand-wordmark-accent">CTF</span></span> }
                else
                { <span class="site-brand-wordmark">@Model.Settings.PlatformName</span> }
              </span>
            }
            else if (Model.Settings.NavbarLogoPath == BrandingStorage.DefaultLogoPath)
            {
              <span class="site-brand-lockup">
                <img class="site-brand-symbol" src="@BrandingStorage.DefaultLogoPath" alt="" aria-hidden="true" asp-append-version="true">
                @if (useOwlCtfWordmark)
                { <span class="site-brand-wordmark"><span>Owl</span><span class="site-brand-wordmark-accent">CTF</span></span> }
                else
                { <span class="site-brand-wordmark">@Model.Settings.PlatformName</span> }
              </span>
            }
            else
            { <img src="@Model.Settings.NavbarLogoPath" alt="Current navbar logo"> }
          }
          else
          { <span>@Model.Settings.PlatformName</span> }
        </div>
        <div class="flex-grow-1">
          <form asp-action="UploadNavbarLogo" method="post" enctype="multipart/form-data">
            <label for="navbarLogo" class="form-label">Choose navbar logo</label>
            <input id="navbarLogo" name="logo" class="form-control" type="file" accept="image/png,image/jpeg,image/webp" required>
            <div class="form-text">Use a PNG, JPEG or WebP up to 2 MB. A wide transparent PNG works best.</div>
            <div class="d-flex flex-wrap gap-2 mt-3">
              <button class="btn btn-owlctf btn-sm" type="submit">Upload logo</button>
              @if (!hasCustomNavbarLogo && Model.Settings.NavbarLogoPath != BrandingStorage.DefaultLogoPath)
              { <button class="btn btn-outline-success btn-sm" type="submit" form="defaultNavbarLogo">Use OwlCTF logo</button> }
              @if (Model.Settings.NavbarLogoPath != BrandingStorage.AdaptiveLogoPath)
              { <button class="btn btn-outline-primary btn-sm" type="submit" form="adaptiveNavbarLogo">Use adaptive logo</button> }
              @if (!string.IsNullOrWhiteSpace(Model.Settings.NavbarLogoPath))
              { <button class="btn btn-outline-secondary btn-sm" type="submit" form="removeNavbarLogo">Remove logo</button> }
            </div>
          </form>
          <form id="defaultNavbarLogo" asp-action="UseDefaultNavbarLogo" method="post"></form>
          <form id="adaptiveNavbarLogo" asp-action="UseAdaptiveNavbarLogo" method="post"></form>
          <form id="removeNavbarLogo" asp-action="RemoveNavbarLogo" method="post"></form>
        </div>
      </div>
    </div>
  </div>
  <div class="panel" id="favicon-branding">
    <div class="panel-header">Browser favicon</div>
    <div class="panel-body">
      <div class="admin-branding-layout">
        <div class="admin-favicon-preview">
          <img src="@(Model.Settings.FaviconPath ?? BrandingStorage.DefaultFaviconPath)" alt="Current browser favicon">
        </div>
        <div class="flex-grow-1">
          <form asp-action="UploadFavicon" method="post" enctype="multipart/form-data">
            <label for="favicon" class="form-label">Choose favicon</label>
            <input id="favicon" name="favicon" class="form-control" type="file" accept="image/png,image/x-icon,image/vnd.microsoft.icon,image/jpeg,image/webp,.ico" required>
            <div class="form-text">PNG or ICO is recommended. Use a square image up to 1 MB.</div>
            <div class="d-flex flex-wrap gap-2 mt-3">
              <button class="btn btn-owlctf btn-sm" type="submit">Upload favicon</button>
              @if (!hasCustomFavicon && Model.Settings.FaviconPath != BrandingStorage.DefaultFaviconPath)
              { <button class="btn btn-outline-secondary btn-sm" type="submit" form="defaultFavicon">Restore OwlCTF favicon</button> }
            </div>
          </form>
          <form id="defaultFavicon" asp-action="UseDefaultFavicon" method="post"></form>
        </div>
      </div>
    </div>
  </div>
  <div class="panel" id="team-capacity">
    <div class="panel-header">Team size</div>
    <div class="panel-body">
      <p class="text-body-secondary mt-0">Set the maximum number of people allowed in each team. Lowering this does not remove existing members; teams already at or above the new limit cannot accept more members.</p>
      <form asp-action="SaveTeamCapacity" method="post" class="admin-inline-setting">
        <label class="form-label" for="maxTeamMembers">Maximum members per team</label>
        <div class="admin-inline-control">
          <input class="form-control" id="maxTeamMembers" name="MaxTeamMembers" type="number" value="@Model.Settings.MaxTeamMembers" min="@TeamCapacityPolicy.MinimumMembers" max="@TeamCapacityPolicy.MaximumMembers" step="1" required>
          <button class="btn btn-owlctf" type="submit">Save team size</button>
        </div>
        <div class="form-text">Choose @TeamCapacityPolicy.MinimumMembers–@TeamCapacityPolicy.MaximumMembers members.</div>
      </form>
    </div>
  </div>
  <div class="panel" id="flag-format">
    <div class="panel-header">Dynamic flag format</div>
    <div class="panel-body">
      <p class="text-body-secondary mt-0">Choose the prefix used for newly generated per-team Docker instance flags. Static challenge flags remain exactly as each challenge author defines them.</p>
      <form asp-action="SaveFlagFormat" method="post" class="admin-inline-setting">
        <label class="form-label" for="flagPrefix">Flag prefix</label>
        <div class="admin-inline-control">
          <input class="form-control text-uppercase" id="flagPrefix" name="FlagPrefix" value="@Model.Settings.FlagPrefix" minlength="2" maxlength="16" pattern="[A-Za-z0-9]+" autocomplete="off" required>
          <button class="btn btn-owlctf" type="submit">Save flag format</button>
        </div>
        <div class="form-text">Letters and numbers only. Preview: <code>@(FlagPrefixPolicy.Normalize(Model.Settings.FlagPrefix) + "{...}")</code></div>
      </form>
    </div>
  </div>
  <div class="panel">
    <div class="panel-header d-flex justify-content-between align-items-center gap-3">
      <span>Home page</span>
      <a class="btn btn-owlctf btn-sm" asp-action="EditHomePage"><i class="fa-solid fa-pen me-1" aria-hidden="true"></i>Edit home page</a>
    </div>
    <div class="panel-body">
      <div class="profile-detail-row"><span class="text-body-secondary">Page title</span><span>@Model.Settings.PlatformName</span></div>
      <div class="profile-detail-row"><span class="text-body-secondary">Content sections</span><span>About · Instructions · Contact · 3 sponsor slots</span></div>
    </div>
  </div>
  <div class="panel">
    <div class="panel-header d-flex justify-content-between align-items-center gap-3">
      <span>Event schedule</span>
      <a class="btn btn-owlctf btn-sm" asp-action="EditEventSchedule">Manage schedule</a>
    </div>
    <div class="panel-body">
      <div class="profile-detail-row"><span class="text-body-secondary">Starts (local time)</span><span>@if (Model.Settings.StartsAtUtc is DateTime startsAt) { <time data-local-time datetime="@TimeDisplay.UtcIso(startsAt)">@startsAt.ToString("yyyy-MM-dd HH:mm")</time> } else { <span>Not scheduled</span> }</span></div>
      <div class="profile-detail-row"><span class="text-body-secondary">Ends (local time)</span><span>@if (Model.Settings.EndsAtUtc is DateTime endsAt) { <time data-local-time datetime="@TimeDisplay.UtcIso(endsAt)">@endsAt.ToString("yyyy-MM-dd HH:mm")</time> } else { <span>Not scheduled</span> }</span></div>
      <div class="profile-detail-row"><span class="text-body-secondary">Current state</span><span>@CtfState.From(Model.Settings, DateTime.UtcNow).Phase</span></div>
    </div>
  </div>
  <div class="panel">
    <div class="panel-header d-flex flex-wrap justify-content-between align-items-center gap-2">
      <span>Discord first blood</span>
      @if (Model.Settings.FirstBloodEnabled && !string.IsNullOrWhiteSpace(Model.Settings.FirstBloodWebhookUrl))
      { <span class="badge text-bg-success">Enabled</span> }
      else
      { <span class="badge text-bg-secondary">Disabled</span> }
    </div>
    <div class="panel-body">
      <p class="text-body-secondary mt-0">Celebrate the first eligible solve for each challenge. Discord receives the challenge, team, solver, points and solve time.</p>
      <form asp-action="SaveFirstBloodSettings" method="post" class="row g-3 align-items-end">
        <div class="col-12">
          <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" id="firstBloodEnabled" name="Enabled" value="true" checked="@Model.Settings.FirstBloodEnabled">
            <label class="form-check-label" for="firstBloodEnabled">Enable first-blood announcements</label>
          </div>
        </div>
        <div class="col-lg-8">
          <label class="form-label" for="firstBloodWebhookUrl">Discord channel webhook URL</label>
          <input class="form-control" type="password" id="firstBloodWebhookUrl" name="WebhookUrl" maxlength="500" autocomplete="new-password" placeholder="@(string.IsNullOrWhiteSpace(Model.Settings.FirstBloodWebhookUrl) ? "https://discord.com/api/webhooks/..." : "Webhook configured — enter a new URL to replace it")">
          <div class="form-text">Create a webhook in the destination Discord channel. The saved token is never shown on this page.</div>
        </div>
        <div class="col-lg-4">
          <div class="form-check mb-2">
            <input class="form-check-input" type="checkbox" id="removeFirstBloodWebhook" name="RemoveWebhook" value="true">
            <label class="form-check-label" for="removeFirstBloodWebhook">Remove saved webhook</label>
          </div>
          <button class="btn btn-owlctf btn-sm" type="submit">Save Discord settings</button>
        </div>
      </form>
      @if (!string.IsNullOrWhiteSpace(Model.Settings.FirstBloodWebhookUrl))
      {
        <form asp-action="TestFirstBloodWebhook" method="post" class="mt-3">
          <button class="btn btn-outline-secondary btn-sm" type="submit">Send test message</button>
        </form>
      }
    </div>
  </div>
</div></main>
