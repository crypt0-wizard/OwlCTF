@using System.Text.Json
@model HomeViewModel
@{
  ViewData["Title"] = null;
  var cspNonce = Context.Items["CspNonce"] as string;
  var hasInstructions = !string.IsNullOrWhiteSpace(Model.InstructionsHtml);
  var hasContact = !string.IsNullOrWhiteSpace(Model.ContactHtml);
  var hasSponsors = Model.SponsorLogos.Count > 0;
}
<main>
  <div class="container">
    <h1 class="welcome-heading">Welcome to @Model.Settings.PlatformName</h1>
    <div class="panel"><div class="ctf-status-panel">
      <p id="ctfStatus" class="ctf-status-copy mb-0" aria-live="polite">
        <span id="ctfStatusLabel"></span>
        <strong id="ctfCountdown" class="ctf-countdown-value d-none"></strong>
      </p>
    </div></div>
  </div>
</main>
<section class="home-content-sections"><div class="container">
  <div id="about" class="panel">
    <div class="panel-header home-section-heading"><i class="fa-solid fa-circle-info" aria-hidden="true"></i><span>About</span></div>
    <div class="panel-body markdown-content">@if (string.IsNullOrWhiteSpace(Model.AboutHtml)) { <p>Event details are on the way.</p> } else { @Html.Raw(Model.AboutHtml) }</div>
  </div>
  @if (hasInstructions)
  {
    <div id="instructions" class="panel">
      <div class="panel-header home-section-heading"><i class="fa-solid fa-list-check" aria-hidden="true"></i><span>Instructions</span></div>
      <div class="panel-body markdown-content">@Html.Raw(Model.InstructionsHtml)</div>
    </div>
  }
  @if (hasContact)
  {
    <div id="contact" class="panel">
      <div class="panel-header home-section-heading"><i class="fa-solid fa-envelope" aria-hidden="true"></i><span>Contact</span></div>
      <div class="panel-body markdown-content">@Html.Raw(Model.ContactHtml)</div>
    </div>
  }
  @if (hasSponsors)
  {
    <div id="sponsors" class="panel mb-0">
      <div class="panel-header home-section-heading"><i class="fa-solid fa-handshake" aria-hidden="true"></i><span>Sponsors</span></div>
      <div class="panel-body">
        <p class="sponsor-thanks">A big thank-you to the sponsors who keep the challenges sharp, the infrastructure running and the flags flying.</p>
        <div class="home-sponsor-grid">
          @foreach (var logo in Model.SponsorLogos)
          {
            <div class="home-sponsor-logo">
              <img src="@logo.PublicPath" alt="Sponsor @logo.Slot logo" loading="lazy">
            </div>
          }
        </div>
      </div>
    </div>
  }
</div></section>
@section Scripts {
<script nonce="@cspNonce">
  const CTF_START = @Html.Raw(JsonSerializer.Serialize(Model.Settings.StartsAtUtc is DateTime startsAt ? TimeDisplay.UtcIso(startsAt) : null));
  const CTF_END = @Html.Raw(JsonSerializer.Serialize(Model.Settings.EndsAtUtc is DateTime endsAt ? TimeDisplay.UtcIso(endsAt) : null));
  const PLATFORM_NAME = @Html.Raw(JsonSerializer.Serialize(Model.Settings.PlatformName));
  const statusLabelEl = document.getElementById('ctfStatusLabel');
  const countdownEl = document.getElementById('ctfCountdown');
  function countdownText(target, now) {
    const totalSeconds = Math.max(0, Math.floor((target.getTime() - now.getTime()) / 1000));
    const days = Math.floor(totalSeconds / 86400);
    const hours = Math.floor((totalSeconds % 86400) / 3600);
    const minutes = Math.floor((totalSeconds % 3600) / 60);
    const seconds = totalSeconds % 60;
    const parts = [];
    if (days > 0) parts.push(days + (days === 1 ? ' day' : ' days'));
    parts.push(String(hours).padStart(2, '0') + 'h');
    parts.push(String(minutes).padStart(2, '0') + 'm');
    parts.push(String(seconds).padStart(2, '0') + 's');
    return parts.join(' ');
  }
  function showStatus(label, countdown) {
    statusLabelEl.textContent = label;
    if (countdown) {
      countdownEl.textContent = countdown;
      countdownEl.classList.remove('d-none');
    } else {
      countdownEl.textContent = '';
      countdownEl.classList.add('d-none');
    }
  }
  function updateStatus() {
    if (!CTF_START && !CTF_END) { showStatus('No event is scheduled yet. Check back soon.'); return; }
    const now = new Date(); const start = CTF_START ? new Date(CTF_START) : null; const end = CTF_END ? new Date(CTF_END) : null;
    if (start && now < start) showStatus(PLATFORM_NAME + ' starts in', countdownText(start, now));
    else if (end && now > end) showStatus(PLATFORM_NAME + ' has ended. Thanks for playing.');
    else if (end) showStatus(PLATFORM_NAME + ' ends in', countdownText(end, now));
    else showStatus(PLATFORM_NAME + ' is live right now!');
  }
  updateStatus();
  setInterval(updateStatus, 1000);
</script>
}
