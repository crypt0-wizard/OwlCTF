@model ErrorPageViewModel
@{
  Layout = "_ErrorLayout";
  ViewData["Title"] = Model.Title;
}
<main class="error-page">
  <div class="container">
    <section class="error-card" aria-labelledby="errorTitle">
      <img class="error-brand-mark" src="@BrandingStorage.DefaultLogoPath" alt="" aria-hidden="true" asp-append-version="true">
      <div class="error-status">Error @Model.StatusCode</div>
      <h1 id="errorTitle">@Model.Title</h1>
      <p>@Model.Message</p>
      <div class="error-actions">
        <a class="btn btn-owlctf" asp-controller="Home" asp-action="Index">Go home</a>
        @if (Model.StatusCode == StatusCodes.Status401Unauthorized)
        {
          <a class="btn btn-outline-secondary" asp-controller="Auth" asp-action="Login">Sign in with Discord</a>
        }
        else
        {
          <a class="btn btn-outline-secondary" asp-controller="Challenges" asp-action="Index">Browse challenges</a>
        }
      </div>
      @if (!string.IsNullOrWhiteSpace(Model.RequestId))
      {
        <div class="error-reference">Reference <code>@Model.RequestId</code></div>
      }
    </section>
  </div>
</main>
