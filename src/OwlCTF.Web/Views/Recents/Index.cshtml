@using OwlCTF.Services
@model IReadOnlyList<RecentSolveRecord>
@{
  ViewData["Title"] = "Recents";
  var cspNonce = Context.Items["CspNonce"] as string;
}
<main><div class="container">
  <div>
    <h1 class="welcome-heading mb-1">Recent solves</h1>
    <p class="text-body-secondary mb-0">See the latest solves from teams across the event.</p>
  </div>

  <div class="panel mt-4">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0 recent-solves-table">
        <thead><tr><th scope="col">Solved at (local time)</th><th scope="col">Team</th><th scope="col">Member</th><th scope="col">Challenge</th></tr></thead>
        <tbody id="recentSolves">
        @if (Model.Count == 0)
        {
          <tr id="emptyRecents"><td colspan="4" class="text-center text-body-secondary py-5">No solves yet. The first one will appear here.</td></tr>
        }
        @foreach (var solve in Model)
        {
          var country = CountryCatalog.All.FirstOrDefault(item => item.Code == solve.CountryCode);
          var countryCode = solve.CountryCode?.ToLowerInvariant();
          <tr data-solve-id="@solve.Id">
            <td class="recent-solve-time"><time data-local-time datetime="@TimeDisplay.UtcIso(solve.SolvedAtUtc)">@solve.SolvedAtUtc.ToString("yyyy-MM-dd HH:mm:ss")</time></td>
            <td><span class="standings-team-line"><a asp-controller="Directory" asp-action="Team" asp-route-id="@solve.TeamId" class="text-decoration-none fw-medium">@solve.TeamName</a>@if (country is not null && countryCode is not null) { <span class="fi fi-@countryCode standings-team-flag" role="img" aria-label="@country.Name flag" title="@country.Name"></span> }</span></td>
            <td><a asp-controller="Directory" asp-action="Member" asp-route-id="@solve.UserId">@solve.Username</a></td>
            <td><a asp-controller="Challenges" asp-action="Detail" asp-route-id="@solve.ChallengeId">@solve.ChallengeTitle</a><span class="recent-solve-points">@solve.PointsAwarded pts</span></td>
          </tr>
        }
        </tbody>
      </table>
    </div>
  </div>
</div></main>

@section Scripts {
  <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@10.0.11/dist/browser/signalr.min.js"></script>
  <script nonce="@cspNonce">
    (() => {
      const tableBody = document.getElementById('recentSolves');
      const knownSolves = new Set([...tableBody.querySelectorAll('[data-solve-id]')].map(row => row.dataset.solveId));

      const link = (href, text, className = '') => {
        const anchor = document.createElement('a');
        anchor.href = href;
        anchor.textContent = text;
        anchor.className = className;
        return anchor;
      };
      const cell = () => document.createElement('td');

      const addSolve = solve => {
        const id = String(solve.id);
        if (knownSolves.has(id)) return;
        knownSolves.add(id);
        document.getElementById('emptyRecents')?.remove();

        const row = document.createElement('tr');
        row.dataset.solveId = id;

        const timeCell = cell();
        timeCell.className = 'recent-solve-time recent-solve-new';
        const time = document.createElement('time');
        time.dateTime = solve.solvedAtUtc;
        time.dataset.localTime = '';
        time.textContent = window.owlctfLocalTime.format(solve.solvedAtUtc);
        timeCell.append(time);
        row.append(timeCell);

        const teamCell = cell();
        const teamLine = document.createElement('span');
        teamLine.className = 'standings-team-line';
        teamLine.append(link('/teams/' + encodeURIComponent(solve.teamId), solve.teamName, 'text-decoration-none fw-medium'));
        if (solve.countryCode) {
          const flag = document.createElement('span');
          flag.className = 'fi fi-' + String(solve.countryCode).toLowerCase() + ' standings-team-flag';
          flag.setAttribute('role', 'img');
          flag.setAttribute('aria-label', String(solve.countryCode).toUpperCase() + ' flag');
          teamLine.append(flag);
        }
        teamCell.append(teamLine);
        row.append(teamCell);

        const memberCell = cell();
        memberCell.append(link('/members/' + encodeURIComponent(solve.userId), solve.username));
        row.append(memberCell);

        const challengeCell = cell();
        challengeCell.append(link('/challenges/' + encodeURIComponent(solve.challengeId), solve.challengeTitle));
        const points = document.createElement('span');
        points.className = 'recent-solve-points';
        points.textContent = Number(solve.pointsAwarded).toLocaleString() + ' pts';
        challengeCell.append(points);
        row.append(challengeCell);

        tableBody.prepend(row);
        while (tableBody.querySelectorAll('[data-solve-id]').length > 100)
          tableBody.querySelector('[data-solve-id]:last-child')?.remove();
      };

      const connection = new signalR.HubConnectionBuilder()
        .withUrl('/hubs/activity')
        .withAutomaticReconnect()
        .configureLogging(signalR.LogLevel.Warning)
        .build();

      connection.on('SolveRecorded', addSolve);
      connection.onreconnected(() => window.location.reload());
      connection.onclose(() => {
        setTimeout(start, 5000);
      });

      async function start() {
        try {
          await connection.start();
        } catch {
          setTimeout(start, 5000);
        }
      }
      start();
    })();
  </script>
}
