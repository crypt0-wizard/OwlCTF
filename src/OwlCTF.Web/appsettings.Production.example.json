{
  "ConnectionStrings": {
    "MariaDb": "Server=mariadb;Port=3306;Database=owlctf;User ID=owlctf;Password=use-a-secret;Pooling=true;MinimumPoolSize=0;MaximumPoolSize=40",
    "Redis": "redis:6379,abortConnect=false"
  },
  "Discord": { "ClientId": "discord-application-id", "ClientSecret": "use-a-secret-manager" },
  "Storage": { "RootPath": "/var/lib/owlctf/files", "DataProtectionKeysPath": "/var/lib/owlctf/keys", "MaxFileBytes": 52428800 },
  "Security": { "FlagPepper": "use-a-secret-manager-generated-value" },
  "ReverseProxy": { "KnownProxy": "172.30.0.2" },
  "DynamicInstances": {
    "Enabled": false,
    "DockerEndpoint": "unix:///var/run/docker.sock",
    "PublicHost": "ctf.example.org",
    "GlobalConcurrencyLimit": 20,
    "DefaultTtlSeconds": 1800,
    "RenewalSeconds": 900,
    "MaximumLifetimeSeconds": 7200,
    "ReaperIntervalSeconds": 30,
    "AdminWebhookUrl": "https://admin-webhook.example.org/owlctf-incidents",
    "AutoBanOnCheat": false,
    "BlockFlaggedTeams": true
  },
  "AllowedHosts": "ctf.example.org"
}
