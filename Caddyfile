{
	servers {
		protocols h1 h2 h3
		timeouts {
			read_header 10s
			idle 2m
		}
	}
}

{$CTF_HOST} {
	encode zstd gzip

	log {
		output stdout
		format json
	}

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	reverse_proxy {
		dynamic a web 8080 {
			refresh 5s
			versions ipv4
		}

		lb_policy cookie owlctf_affinity
		lb_try_duration 5s
		lb_try_interval 250ms

		fail_duration 30s
		max_fails 2
		unhealthy_status 502 503 504

		transport http {
			dial_timeout 3s
			keepalive 2m
		}
	}
}
